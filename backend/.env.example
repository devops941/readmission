APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paste your real MongoDB Atlas URI in your local .env
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=readmitexplain
MONGODB_TEST_DB_NAME=readmitexplain_test
MONGODB_TIMEOUT_MS=8000

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ADMIN_EMAIL=admin@readmitexplain.local
ADMIN_PASSWORD=change-me-strong

READMIT_WINDOW_DAYS=30
MIN_CELL_SIZE=20
MIN_EVENTS_SUBGROUP=5
MISSING_COLUMN_WARN_PCT=40
PHI_SCAN_ENABLED=true
RANDOM_SEED=42
BOOTSTRAP_ITERATIONS=500
SHAP_MAX_SAMPLES=300
PSI_WARN=0.1
PSI_CRITICAL=0.25
JOB_TIMEOUT_SEC=600

MODEL_DIR=backend/outputs/models
REPORT_DIR=backend/outputs/reports
UPLOAD_DIR=backend/data/uploads
MAX_UPLOAD_MB=50
